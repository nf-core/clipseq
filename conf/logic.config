/*
 * ---------------------------------------------------
 *  Nextflow config file for deciding which parts of
 *  the pipeline will run
 * ---------------------------------------------------
 */

// Each run_* flag is switched off by the only_* modes that skip that step
params {
    run_input_check   = !params.only_genome
    run_genome_prep   = !(params.only_input || params.only_preprocessing)
    run_preprocessing = !(params.only_input || params.only_genome || params.only_peakcalling)
    run_alignment     = !(params.only_input || params.only_genome || params.only_preprocessing)
    run_filtering     = !(params.only_input || params.only_genome || params.only_preprocessing || params.only_alignment)
    run_dedup         = !(params.only_input || params.only_genome || params.only_preprocessing || params.only_alignment || params.only_filtering)
    run_crosslinking  = !(params.only_input || params.only_genome || params.only_preprocessing || params.only_alignment || params.only_filtering || params.only_dedup)
    run_peakcalling   = !(params.only_input || params.only_genome || params.only_preprocessing || params.only_alignment || params.only_filtering || params.only_dedup || params.only_crosslinks)
    run_peka          = !(params.only_input || params.only_genome || params.only_preprocessing || params.only_alignment || params.only_filtering || params.only_crosslinks || params.only_peakcalling)
    run_reporting     = !(params.only_input || params.only_genome || params.only_preprocessing || params.only_alignment || params.only_filtering || params.only_dedup || params.only_crosslinks || params.only_peakcalling)
}
