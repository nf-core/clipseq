/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests with a more complex sample setup
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/clipseq -profile test_full_small,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'test.config'

params {
    config_profile_name        = 'Test Full Small profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    input  = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/clipseq/v_2_0/samplesheets/multi-se-with-merge.csv'

    // Tiny test data: clippy defaults find no peaks (missing *_Peaks.bed), and PEKA 1.0.2 crashes
    // (NameError in peka.py) on regions without thresholded sites; -sr intergenic exits cleanly
    clippy_params = '-mg 1 -mb 1'
    peka_params   = '-sr intergenic'
}
