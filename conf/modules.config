/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'NFCORE_CLIPSEQ:CLIPSEQ:PARSE_FASTQ_INPUT:SAMPLESHEET_CHECK' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}

/*
========================================================================================
    GENOME PREPARATION
========================================================================================
*/


if(params.run_genome_prep) {
    process {
        withName: '.*PREPARE_GENOME:GUNZIP_.*' {
            publishDir = [
                enabled: false
            ]
        }

        withName: '.*PREPARE_GENOME:UNTAR_.*' {
            publishDir = [
                enabled: false
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:PREPARE_GENOME:BOWTIE_BUILD' {
            publishDir = [
                path: { "${params.outdir}/00_genome/index" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_reference
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:PREPARE_GENOME:STAR_GENOMEGENERATE' {
            publishDir = [
                path: { "${params.outdir}/00_genome/index" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_reference
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:PREPARE_GENOME:GENOME_INDEX' {
            publishDir = [
                path: { "${params.outdir}/00_genome" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:PREPARE_GENOME:NCRNA_INDEX' {
            publishDir = [
                path: { "${params.outdir}/00_genome" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_reference
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:PREPARE_GENOME:REMOVE_GTF_BRACKETS' {
            ext.cmd1 = "sed 's/)/_/g' | sed 's/(/_/g'"
            ext.ext = 'gtf'
            ext.suffix = '_brcktsrmv'
            publishDir = [
                enabled: false
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:PREPARE_GENOME:GENOME_CHROM_SIZE' {
            publishDir = [
                path: { "${params.outdir}/00_genome" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_reference
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:PREPARE_GENOME:NCRNA_CHROM_SIZE' {
            publishDir = [
                path: { "${params.outdir}/00_genome" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_reference
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:PREPARE_GENOME:FILTER_GTF_BY_TRANSCRIPT' {
            publishDir = [
                path: { "${params.outdir}/00_genome" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_reference
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:PREPARE_GENOME:ICOUNT_SEG_GTF' {
            publishDir = [
                path: { "${params.outdir}/00_genome" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename ->
                    if (filename.equals('versions.yml')) {
                        return null
                    }
                    if (!params.skip_filter_gtf && filename.endsWith('regions.gtf.gz')) {
                        return null
                    }
                    return filename
                },
                enabled: params.save_reference
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:PREPARE_GENOME:ICOUNT_SEG_FILTGTF' {
            publishDir = [
                path: { "${params.outdir}/00_genome" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: false
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:PREPARE_GENOME:RESOLVE_UNANNOTATED_REGIONS' {
            publishDir = [
                path: { "${params.outdir}/00_genome" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_reference
            ]
        }
    }
}


/*
========================================================================================
    PRE-PROCESSING
========================================================================================
*/

process {
    withName: 'NFCORE_CLIPSEQ:CLIPSEQ:PARSE_FASTQ_INPUT:CAT_FASTQ' {
        publishDir = [
            path: { "${params.outdir}/01_prealign" },
            mode: "${params.publish_dir_mode}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
}

if(params.run_preprocessing && !params.skip_fastqc) {
    process {
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:FASTQ_FASTQC_UMITOOLS_TRIMGALORE:FASTQC' {
            ext.args   = '--quiet'
            publishDir = [
                path: { "${params.outdir}/01_prealign/fastqc" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }
}

if(params.run_preprocessing && !params.skip_umi_extract) {
    process {
        withName: '.*:FASTQ_FASTQC_UMITOOLS_TRIMGALORE:UMITOOLS_EXTRACT' {
            ext.args   = [
                    params.umitools_extract_method ? "--extract-method=${params.umitools_extract_method}" : '',
                    params.umitools_bc_pattern     ? "--bc-pattern='${params.umitools_bc_pattern}'" : '',
                    params.umitools_bc_pattern2    ? "--bc-pattern2='${params.umitools_bc_pattern2}'" : '',
                    params.umitools_umi_separator  ? "--umi-separator='${params.umitools_umi_separator}'" : ''
            ].join(' ').trim()
            publishDir = [
                [
                    path: { "${params.outdir}/01_prealign/umitools" },
                    mode: params.publish_dir_mode,
                    pattern: "*.log"
                ],
                [
                    path: { "${params.outdir}/01_prealign/umitools" },
                    mode: params.publish_dir_mode,
                    pattern: "*.fastq.gz",
                    enabled: params.save_umi_intermeds
                ]
            ]
        }
    }
}

if(params.run_preprocessing && !params.skip_trimming) {
    process {
        withName: '.*:FASTQ_FASTQC_UMITOOLS_TRIMGALORE:TRIMGALORE' {
            ext.args   = {
                [
                    "--fastqc_args '-t ${task.cpus}'",
                    params.extra_trimgalore_args ? params.extra_trimgalore_args.split("\\s(?=--)") : ''
                ].flatten().unique(false).join(' ').trim()
            }
            publishDir = [
                [
                    path: { "${params.outdir}/01_prealign/fastqc" },
                    mode: params.publish_dir_mode,
                    pattern: "*.{html,zip}"
                ],
                [
                    path: { "${params.outdir}/01_prealign/trimmed" },
                    mode: params.publish_dir_mode,
                    pattern: "*.fq.gz",
                    enabled: params.save_trimmed
                ],
                [
                    path: { "${params.outdir}/01_prealign/trimmed" },
                    mode: params.publish_dir_mode,
                    pattern: "*.txt"
                ]
            ]
        }
    }
}

/*
========================================================================================
    ALIGNMENT
========================================================================================
*/

if(params.run_alignment) {
    process {
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:RNA_ALIGN:BOWTIE_ALIGN' {
            ext.args = { "${params.bowtie_params}" }
            ext.prefix = { "${meta.id}_ncrna" }
            publishDir = [
                [
                    path: { "${params.outdir}/02_alignment/ncrna" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.out'
                ],
                [
                    path: { "${params.outdir}/02_alignment/ncrna" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.bam',
                    enabled: false
                ],
                [
                    path: { "${params.outdir}/02_alignment/ncrna/unmapped" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.fastq.gz',
                    enabled: params.save_unaligned_output
                ]
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:RNA_ALIGN:BOWTIE_ALIGN_K1' {
            ext.args = { "${params.bowtie_params}" }
            ext.prefix = { "${meta.id}_ncrna_k1" }
            publishDir = [
                [
                    path: { "${params.outdir}/02_alignment/ncrna" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.out',
                    enabled: false
                ],
                [
                    path: { "${params.outdir}/02_alignment/ncrna" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.bam',
                    enabled: false
                ],
                [
                    path: { "${params.outdir}/02_alignment/ncrna/unmapped" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.fastq.gz',
                    enabled: false
                ]
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:RNA_ALIGN:SAMTOOLS_SORT_NCRNA' {
            ext.prefix = { "${meta.id}_ncrna.sorted" }
            publishDir = [
                path: { "${params.outdir}/02_alignment/ncrna" },
                mode: params.publish_dir_mode,
                pattern: "*.bam",
                enabled: params.save_align_intermed
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:RNA_ALIGN:SAMTOOLS_INDEX_NCRNA' {
            publishDir = [
                path: { "${params.outdir}/02_alignment/ncrna" },
                mode: params.publish_dir_mode,
                pattern: "*.{bai,csi}",
                enabled: params.save_align_intermed
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:RNA_ALIGN:SAMTOOLS_SORT_NCRNA_K1' {
            ext.prefix = { "${meta.id}_ncrna_k1.sorted" }
            publishDir = [
                path: { "${params.outdir}/02_alignment/ncrna" },
                mode: params.publish_dir_mode,
                pattern: "*.bam",
                enabled: false
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:RNA_ALIGN:SAMTOOLS_INDEX_NCRNA_K1' {
            publishDir = [
                path: { "${params.outdir}/02_alignment/ncrna" },
                mode: params.publish_dir_mode,
                pattern: "*.{bai,csi}",
                enabled: false
            ]
        }


        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:RNA_ALIGN:STAR_ALIGN_WITH_TRANSCRIPTOME' {
            ext.args   = { "--readFilesCommand zcat --outSAMtype BAM SortedByCoordinate --quantMode TranscriptomeSAM ${params.star_params}" }
            ext.prefix = { "${meta.id}_multiMapped" }
            publishDir = [
                [
                    path: { "${params.outdir}/02_alignment/genome/log" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.Log.*'
                ],
                [
                    path: { "${params.outdir}/02_alignment/genome" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*Aligned.sortedByCoord.out.bam',
                    enabled: params.save_align_intermed
                ],
                [
                    path: { "${params.outdir}/02_alignment/genome/unmapped" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.fastq.gz',
                    enabled: params.save_unaligned_output
                ]
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:RNA_ALIGN:STAR_ALIGN_GENOME_ONLY' {
            ext.args   = { "--readFilesCommand zcat --outSAMtype BAM SortedByCoordinate ${params.star_params}" }
            ext.prefix = { "${meta.id}_multiMapped" }
            publishDir = [
                [
                    path: { "${params.outdir}/02_alignment/genome/log" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.Log.*'
                ],
                [
                    path: { "${params.outdir}/02_alignment/genome" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*Aligned.sortedByCoord.out.bam',
                    enabled: params.save_align_intermed
                ],
                [
                    path: { "${params.outdir}/02_alignment/genome/unmapped" },
                    mode: "${params.publish_dir_mode}",
                    pattern: '*.fastq.gz',
                    enabled: params.save_unaligned_output
                ]
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:RNA_ALIGN:TONLY_SAMTOOLS_VIEW_GENOME' {
            ext.prefix = { "${meta.id}_uniqueMapped" }
            ext.args   = "-q 5 --output-fmt bam --write-index"
            ext.index_type = "bai"
            publishDir = [
                path: { "${params.outdir}/02_alignment/genome" },
                mode: params.publish_dir_mode,
                pattern: "*.{bai,bam}",
                enabled: params.save_align_intermed
            ]       
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:RNA_ALIGN:TONLY_SAMTOOLS_VIEW_TRANSCRIPT' {
            ext.prefix = { "${meta.id}_uniqueMapped" }
            ext.args   = "-q 5 --output-fmt bam --write-index"
            ext.index_type = "bai"
            publishDir = [
                path: { "${params.outdir}/02_alignment/genome" },
                mode: params.publish_dir_mode,
                pattern: "*.{bai,bam}",
                enabled: params.save_align_intermed
            ]       
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:RNA_ALIGN:GONLY_SAMTOOLS_VIEW_GENOME' {
            ext.prefix = { "${meta.id}_uniqueMapped" }
            ext.args   = "-q 5 --output-fmt bam --write-index"
            ext.index_type = "bai"
            publishDir = [
                path: { "${params.outdir}/02_alignment/genome" },
                mode: params.publish_dir_mode,
                pattern: "*.{bai,bam}",
                enabled: params.save_align_intermed
            ]       
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:RNA_ALIGN:SAMTOOLS_INDEX_COORD_GONLY' {
            publishDir = [
                path: { "${params.outdir}/02_alignment/genome" },
                mode: params.publish_dir_mode,
                pattern: "*.{bai,csi}",
                enabled: params.save_align_intermed
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:RNA_ALIGN:SAMTOOLS_INDEX_COORD_TONLY' {
            publishDir = [
                path: { "${params.outdir}/02_alignment/genome" },
                mode: params.publish_dir_mode,
                pattern: "*.{bai,csi}",
                enabled: params.save_align_intermed
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:RNA_ALIGN:SAMTOOLS_SORT_TRANS' {
            ext.prefix = { "${meta.id}.sorted" }
            publishDir = [
                enabled: false
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:RNA_ALIGN:SAMTOOLS_INDEX_TRANS' {
            publishDir = [
                enabled: false
            ]
        }
    }
}

/*
========================================================================================
    FILTERING
========================================================================================
*/

if(params.run_filtering) {
    process {
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:TRANSCRIPTOME_PROCESSING:FILTER_TRANSCRIPTS' {
            ext.args   = '-h'
            ext.prefix = { "${meta.id}.transcript.filt" }
            publishDir = [
                path: { "${params.outdir}/03_filt_dedup" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: false
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:TRANSCRIPTOME_PROCESSING:SAMTOOLS_SORT_FILT_TRANSCRIPT' {
            ext.prefix = { "${meta.id}.transcript.filt.sorted" }
            publishDir = [
                path: { "${params.outdir}/03_filt_dedup" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_align_intermed
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:TRANSCRIPTOME_PROCESSING:SAMTOOLS_INDEX_FILT_TRANSCRIPT' {
            publishDir = [
                path: { "${params.outdir}/03_filt_dedup" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_align_intermed
            ]
        }
    }
}

/*
========================================================================================
    DEDUPLICATION
========================================================================================
*/

if(params.run_dedup) {
    process {
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:GENOME_UNIQUE_DEDUP:UMICOLLAPSE' {
            ext.args = { "--umi-sep ${params.umitools_umi_separator}" }
            ext.prefix = { "${meta.id}.genomeUnique.dedup" }
            publishDir = [
                path: { "${params.outdir}/03_filt_dedup" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:GENOME_MULTI_DEDUP:UMICOLLAPSE' {
            ext.args = { "--umi-sep ${params.umitools_umi_separator}" }
            ext.prefix = { "${meta.id}.genomeMulti.dedup" }
            publishDir = [
                path: { "${params.outdir}/03_filt_dedup" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        } 

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:NCRNA_DEDUP:UMICOLLAPSE' {
            ext.args = { "--umi-sep ${params.umitools_umi_separator}" }
            ext.prefix = { "${meta.id}.ncRNA.dedup" }
            publishDir = [
                path: { "${params.outdir}/03_filt_dedup" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:NCRNA_K1_DEDUP:UMICOLLAPSE' {
            ext.args = { "--umi-sep ${params.umitools_umi_separator}" }
            ext.prefix = { "${meta.id}.ncRNA_K1.dedup" }
            publishDir = [
                path: { "${params.outdir}/03_filt_dedup" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: false
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:(GENOME.*|NCRNA)_DEDUP:SAMTOOLS_INDEX' {
            publishDir = [
                path: { "${params.outdir}/03_filt_dedup" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:NCRNA_K1_DEDUP:SAMTOOLS_INDEX' {
            publishDir = [
                path: { "${params.outdir}/03_filt_dedup" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: false
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:TRANSCRIPTOME_PROCESSING:TRANS_DEDUP:UMICOLLAPSE' {
            ext.args = { "--umi-sep ${params.umitools_umi_separator}" }
            ext.prefix = { "${meta.id}.transcript.dedup" }
            publishDir = [
                path: { "${params.outdir}/03_filt_dedup" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:TRANSCRIPTOME_PROCESSING:TRANS_DEDUP:SAMTOOLS_INDEX' {
            publishDir = [
                path: { "${params.outdir}/03_filt_dedup" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }
}

/*
========================================================================================
    CROSSLINKING
========================================================================================
*/

if(params.run_crosslinking) { 
    process{
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:.*_RESOLVE_GROUPS_AND_CROSSLINKS:SAMTOOLS_MERGE' {
            publishDir = [
                path: { "${params.outdir}/04_crosslinks/grouped_crosslinks" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: false
            ]
        }
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:.*_RESOLVE_GROUPS_AND_CROSSLINKS:SAMTOOLS_GROUP_INDEX' {
            publishDir = [
                path: { "${params.outdir}/04_crosslinks/grouped_crosslinks" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: false
            ]
        }
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:GENOME_RESOLVE_GROUPS_AND_CROSSLINKS:CALC_CROSSLINKS_INDIVIDUAL.*' {
            ext.suffix = '.genome'
            publishDir = [
                path: { "${params.outdir}/04_crosslinks" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:NCRNA_RESOLVE_GROUPS_AND_CROSSLINKS:CALC_CROSSLINKS_INDIVIDUAL.*' {
            ext.suffix = '.ncrna'
            publishDir = [
                path: { "${params.outdir}/04_crosslinks" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:GENOME_RESOLVE_GROUPS_AND_CROSSLINKS:STRAND_SPLIT.*' {
            publishDir = [
                enabled: false
            ]
        }
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:NCRNA_RESOLVE_GROUPS_AND_CROSSLINKS:STRAND_SPLIT.*' {
            publishDir = [
                enabled: false
            ]
        }
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:GENOME_RESOLVE_GROUPS_AND_CROSSLINKS:BIGWIG_POS_INDIVIDUAL.*' {
            ext.prefix = { "${meta.id}.genome_plus" }
            publishDir = [
                path: { "${params.outdir}/04_crosslinks" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:GENOME_RESOLVE_GROUPS_AND_CROSSLINKS:BIGWIG_NEG_INDIVIDUAL.*' {
            ext.prefix = { "${meta.id}.genome_minus" }
            publishDir = [
                path: { "${params.outdir}/04_crosslinks" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:NCRNA_RESOLVE_GROUPS_AND_CROSSLINKS:BIGWIG_POS_INDIVIDUAL.*' {
            ext.prefix = { "${meta.id}.ncrna_plus" }
            publishDir = [
                path: { "${params.outdir}/04_crosslinks" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:NCRNA_RESOLVE_GROUPS_AND_CROSSLINKS:BIGWIG_NEG_INDIVIDUAL.*' {
            ext.prefix = { "${meta.id}.ncrna_minus" }
            publishDir = [
                path: { "${params.outdir}/04_crosslinks" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:NCRNA_RESOLVE_GROUPS_AND_CROSSLINKS:BIGWIG_POS_GROUP_HASGROUP' {
            ext.prefix = { "${meta.id}.ncrna_grouped_plus" }
            publishDir = [
                path: { "${params.outdir}/04_crosslinks/grouped_crosslinks" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:NCRNA_RESOLVE_GROUPS_AND_CROSSLINKS:BIGWIG_NEG_GROUP_HASGROUP' {
            ext.prefix = { "${meta.id}.ncrna_grouped_minus" }
            publishDir = [
                path: { "${params.outdir}/04_crosslinks/grouped_crosslinks" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:GENOME_RESOLVE_GROUPS_AND_CROSSLINKS:BIGWIG_POS_GROUP_HASGROUP' {
            ext.prefix = { "${meta.id}.genome_grouped_plus" }
            publishDir = [
                path: { "${params.outdir}/04_crosslinks/grouped_crosslinks" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:GENOME_RESOLVE_GROUPS_AND_CROSSLINKS:BIGWIG_NEG_GROUP_HASGROUP' {
            ext.prefix = { "${meta.id}.genome_grouped_minus" }
            publishDir = [
                path: { "${params.outdir}/04_crosslinks/grouped_crosslinks" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:GENOME_RESOLVE_GROUPS_AND_CROSSLINKS:CALC_CROSSLINKS_GROUP_HASGROUP' {
            ext.suffix = '_grouped.genome'
            publishDir = [
                path: { "${params.outdir}/04_crosslinks/grouped_crosslinks" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:NCRNA_RESOLVE_GROUPS_AND_CROSSLINKS:CALC_CROSSLINKS_GROUP_HASGROUP' {
            ext.suffix = '_grouped.ncrna'
            publishDir = [
                path: { "${params.outdir}/04_crosslinks/grouped_crosslinks" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:CONSENSUS_CROSSLINKS_CAT_CAT' {
            ext.prefix = 'all_merged_xls.temp'
            publishDir = [
                enabled: false
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:CONSENSUS_CROSSLINKS_BEDTOOLS_SORT' {
            ext.suffix = 'all_merged_xls'
            publishDir = [
                enabled: false
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:CONSENSUS_CROSSLINKS_BEDTOOLS_GROUPBY' {
            ext.prefix = 'all_merged_xls'
            ext.args = { "-g 1,2,3,6 -o sum" }
            publishDir = [
                enabled: false
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:CONSENSUS_CROSSLINKS_REORDER_BED' {
            ext.cmd1 = 'awk \'{OFS = "\t"}{print \$1, \$2, \$3, ".", \$5, \$4}\' | sort -k1,1 -k2,2n -k3,3 -k6,6'
            ext.suffix = 'all_merged_xls'
            ext.ext = 'bed'
            publishDir = [
                enabled: false
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:TRANSCRIPTOME_PROCESSING:CALC_TRANSCRIPT_CROSSLINKS_INDIVIDUAL' {
            ext.suffix = '.transcript'
            publishDir = [
                path: { "${params.outdir}/04_crosslinks/transcript" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:TRANSCRIPTOME_PROCESSING:CALC_TRANSCRIPT_CROSSLINKS_INDIVIDUAL_HASGROUP' {
            ext.suffix = '.transcript'
            publishDir = [
                path: { "${params.outdir}/04_crosslinks/transcript" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:TRANSCRIPTOME_PROCESSING:CALC_TRANSCRIPT_CROSSLINKS_GROUP_HASGROUP' {
            ext.suffix = '_grouped.transcript'
            publishDir = [
                path: { "${params.outdir}/04_crosslinks/transcript/grouped_crosslinks" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:ICOUNTMINI_SUMMARY' {
            publishDir = [
                path: { "${params.outdir}/04_crosslinks/icountmini_summaries" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: false
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:MERGE_SUMMARY' {
            publishDir = [
                path: { "${params.outdir}/04_crosslinks/icountmini_summaries" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:ICOUNTMINI_METAGENE' {
            publishDir = [
                path: { "${params.outdir}/04_crosslinks/icountmini_metagene" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }
}


/*
========================================================================================
    PEAK CALLING
========================================================================================
*/

if(params.run_peakcalling && params.consensus_peak){
    process {
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:.*CONSENSUS_PEAK_TABLE:CROSSLINKS_SORT' {
            publishDir = [
                enabled: false
            ]
        }
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:.*CONSENSUS_PEAK_TABLE:CONSENSUS_PEAKS_SORT' {
            publishDir = [
                enabled: false
            ]
        }
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:.*CONSENSUS_PEAK_TABLE:CONSENSUS_MAP' {
            ext.prefix = { "${meta.id}_consensus_map" }
            publishDir = [
                path: { "${params.outdir}/05_peakcalling/consensus_peak_tables" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: false
            ]
        }
        withName: 'NFCORE_CLIPSEQ:CLIPSEQ:.*CONSENSUS_PEAK_TABLE:GET_CONSENSUS_COUNTS' {
            publishDir = [
                path: { "${params.outdir}/05_peakcalling/consensus_peak_tables" },
                mode: "${params.publish_dir_mode}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }
}


if(params.run_peakcalling && params.peakcaller.contains('clippy')) {
    process {
