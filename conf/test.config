/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/clipseq -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Limit resources so that this can run on GitHub Actions
    max_cpus   = 2
    max_memory = '8.GB'
    max_time   = '6.h'

    // Input data
    input  = 'tests/test_new_samplesheet_FASTQ.csv'
    source = "fastq"

    // Genome references - chr21 test dataset
    fasta = "assets/reference/Homo_sapiens.GRCh38.chr21.dna.fa.gz"
    ncrna_fasta = "assets/reference/Homo_sapiens.GRCh38.chr21.ncrna.fa"
    gtf = "assets/reference/hg38_chr21.gtf"
    genome_index = "assets/reference/star_chr21.tar.gz"
    ncrna_genome_index = "assets/reference/bowtie_ncrna_chr21.tar.gz"
    genome_chrom_sizes = "assets/reference/Homo_sapiens.GRCh38.chr21.fa.sizes"
    ncrna_chrom_sizes = null  // Will be auto-generated from ncrna_fasta if not provided
    representative_transcript = "assets/reference/longest_transcript.txt"
    representative_transcript_fai = "assets/reference/longest_transcript.fai"
    representative_transcript_gtf = "assets/reference/longest_transcript.gtf"
    filtered_gtf = "assets/reference/Homo_sapiens.GRCh38_chr21_filtered.gtf"
    seg_gtf = "assets/reference/Homo_sapiens.GRCh38_chr21_seg.gtf"
    regions_gtf = "assets/reference/Homo_sapiens.GRCh38_chr21_regions.gtf.gz"
    regions_filt_gtf = "assets/reference/Homo_sapiens.GRCh38_chr21_filtered_regions.gtf.gz"
    regions_resolved_gtf = "assets/reference/Homo_sapiens.GRCh38_chr21_filtered_regions.resolved.gtf"

    // Logic
    debug                 = true
    save_reference        = true
    skip_umi_extract      = false
    save_umi_intermeds    = true
    save_trimmed          = true
    save_unaligned_output = true
    save_align_intermed   = true
    skip_transcriptome    = true
    skip_filter_gtf       = false

    // Pipeline params
    umitools_bc_pattern = 'NNNNNNNNN'
}
