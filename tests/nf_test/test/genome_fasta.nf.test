nextflow_pipeline {
    name "genome_fasta"
    script "main.nf"

    test("genome_fasta_raw") {
        tag "genome_fasta_raw"
        tag "test"
        when {
            params {
                outdir = "$outputDir"
                only_genome = true
                save_reference = true
                fasta = "s3://ngi-igenomes/igenomes/Saccharomyces_cerevisiae/Ensembl/R64-1-1/Sequence/WholeGenomeFasta/genome.fa"
            }
        }

        then {
            assert workflow.success

            // Test fai created as we did not supply one
            assert file("$outputDir/00_genome/genome.fa.fai").exists()
        }
    }

    test("genome_fasta_gz") {
        tag "genome_fasta_gz"
        tag "test"
        when {
            params {
                outdir = "$outputDir"
                only_genome = true
                save_reference = true
                fasta = "assets/reference/Homo_sapiens.GRCh38.chr21.dna.fa.gz"
            }
        }

        then {
            assert workflow.success

            // Test fai created as we did not supply one
            assert file("$outputDir/00_genome/Homo_sapiens.GRCh38.chr21.dna.fa.fai").exists()
        }
    }

    test("genome_fasta_fai") {
        tag "genome_fasta_fai"
        tag "test"
        when {
            params {
                outdir = "$outputDir"
                only_genome = true
                save_reference = true
                fasta = "assets/reference/Homo_sapiens.GRCh38.chr21.dna.fa.gz"
                fasta_fai = "assets/reference/Homo_sapiens.GRCh38.chr21.dna.fa.gz.fai"
            }
        }

        then {
            assert workflow.success

            // Check fai does not exist as the process should not have run to generate it
            // When fasta_fai is provided, the pipeline uses it internally but doesn't publish
            // it to the output directory (since the GENOME_INDEX process that would publish it doesn't run)
            assert !(file("$outputDir/00_genome/Homo_sapiens.GRCh38.chr21.dna.fa.fai").exists())
        }
    }

    test("genome_ncrna_fasta_gz") {
        tag "genome_ncrna_fasta_gz"
        tag "test"
        when {
            params {
                outdir = "$outputDir"
                only_genome = true
                save_reference = true
                ncrna_fasta = "assets/reference/Homo_sapiens.GRCh38.chr21.ncrna.fa"
            }
        }

        then {
            assert workflow.success

            assert file("$outputDir/00_genome/Homo_sapiens.GRCh38.chr21.ncrna.fa.fai").exists()
        }
    }

    test("genome_ncrna_fasta") {
        tag "genome_ncrna_fasta"
        tag "test"
        when {
            params {
                outdir = "$outputDir"
                only_genome = true
                save_reference = true
                ncrna_fasta = "assets/reference/Homo_sapiens.GRCh38.chr21.ncrna.fa"
            }
        }

        then {
            assert workflow.success

            assert file("$outputDir/00_genome/Homo_sapiens.GRCh38.chr21.ncrna.fa.fai").exists()
        }
    }

    test("genome_ncrna_fasta_fai") {
        tag "genome_ncrna_fasta_fai"
        tag "test"
        when {
            params {
                outdir = "$outputDir"
                only_genome = true
                save_reference = true
                ncrna_fasta = "assets/reference/Homo_sapiens.GRCh38.chr21.ncrna.fa"
                fasta_fai = "assets/reference/Homo_sapiens.GRCh38.chr21.ncrna.fa.gz.fai"
            }
        }

        then {
            assert workflow.success

            // Check fai does not exist as the process should not have run to generate it
            // When fasta_fai is provided, the pipeline uses it internally but doesn't publish
            // it to the output directory (since the NCRNA_INDEX process that would publish it doesn't run)
            assert !(file("$outputDir/00_genome/Homo_sapiens.GRCh38.chr21.ncrna.fa.fai").exists())
        }
    }
}
