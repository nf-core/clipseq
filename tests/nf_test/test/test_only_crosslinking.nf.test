nextflow_pipeline {
    name "only_crosslinking"
    script "main.nf"

    test("only_crosslinking_primary") {
        tag "only_crosslinking_primary"
        tag "test"
        when {
            params {
                outdir = "$outputDir"
                only_crosslinks = true
            }
        }

        then {
            assert workflow.success

            assert file("$outputDir/04_crosslinks/HNRNPC_Hs_HeLa_R1.genome.xl.bed").exists()
            assert file("$outputDir/04_crosslinks/HNRNPC_Hs_HeLa_R1.genome.xl.bedgraph").exists()
            assert file("$outputDir/04_crosslinks/HNRNPC_Hs_HeLa_R1.genome.xl.CPMnorm.bedgraph").exists()

            assert file("$outputDir/04_crosslinks/grouped_crosslinks/HNRNPC_grouped.genome.xl.bed").exists()
            assert file("$outputDir/04_crosslinks/grouped_crosslinks/HNRNPC_grouped.genome.xl.bedgraph").exists()
            assert file("$outputDir/04_crosslinks/grouped_crosslinks/HNRNPC_grouped.genome.xl.CPMnorm.bedgraph").exists()

            assert file("$outputDir/04_crosslinks/icountmini_summaries/HNRNPC.summary_gene_premapadjusted.tsv").exists()
            assert file("$outputDir/04_crosslinks/icountmini_summaries/HNRNPC.summary_subtype_premapadjusted.tsv").exists()
            assert file("$outputDir/04_crosslinks/icountmini_summaries/HNRNPC.summary_type_premapadjusted.tsv").exists()
        }
    }
}
