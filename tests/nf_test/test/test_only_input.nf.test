nextflow_pipeline {
    name "only_input"
    script "main.nf"

    test("only_input_primary") {
        tag "only_input_primary"
        tag "test"
        when {
            params {
                outdir = "$outputDir"
                only_input = true
            }
        }

        then {
            assert workflow.success

            assert !(file("$outputDir/01_prealign/umitools/PHO92_A.umi_extract.fastq.gz").exists())
        }
    }
}
