nextflow_pipeline {
    name "prepare_genome_representative_transcript"
    script "main.nf"

    test("genome_no_representative_transcript") {
        tag "genome_no_representative_transcript"
        tag "test"
        when {
            params {
                outdir = "$outputDir"
                only_genome = true
                save_reference = true
                representative_transcript = null
            }
        }

        then {
            assert workflow.success

            assert file("$outputDir/00_genome/representative_transcript.txt").exists()
            assert file("$outputDir/00_genome/representative_transcript.fai").exists()
            assert file("$outputDir/00_genome/representative_transcript.gtf").exists()
        }
    }
}
