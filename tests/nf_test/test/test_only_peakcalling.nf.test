nextflow_pipeline {
    name "only_peakcalling"
    script "main.nf"

    test("only_peakcalling_primary") {
        tag "only_peakcalling_primary"
        tag "test"
        when {
            params {
                outdir = "$outputDir"
                only_peakcalling = true
            }
        }

        then {
            assert workflow.success

            // clippy
            assert file("$outputDir/05_peakcalling/clippy/PHO92.genome.peaks_rollmean10_minHeightAdjust1.0_minPromAdjust1.0_minGeneCount5_Peaks.bed").exists()
            assert file("$outputDir/05_peakcalling/clippy/PHO92.genome.peaks_rollmean10_minHeightAdjust1.0_minPromAdjust1.0_minGeneCount5_Summits.bed").exists()
            // icount
            assert file("$outputDir/05_peakcalling/icountmini/PHO92.sigxls.bed").exists()
            assert file("$outputDir/05_peakcalling/icountmini/PHO92.peaks.bed").exists()
            // paraclu
            assert file("$outputDir/05_peakcalling/paraclu/PHO92.genome.peaks.clustered.simplified.bed").exists()
            // pureclip
            assert file("$outputDir/05_peakcalling/pureclip/PHO92_pureclip_crosslinks.bed").exists()
            assert file("$outputDir/05_peakcalling/pureclip/PHO92_pureclip_peaks.bed").exists()
        }
    }

    test("only_peakcalling_caller_param_fail") {
        tag "only_peakcalling_caller_param_fail"
        tag "test"
        when {
            params {
                outdir = "$outputDir"
                only_input = true
                peakcaller = 'test'
            }
        }

        then {
            assert workflow.failed
            assert workflow.exitStatus == 1
            assert workflow.trace.succeeded().size() == 0
            assert workflow.trace.failed().size() == 0
        }
    }

    test("only_peakcalling_clippy") {
        tag "only_peakcalling_clippy"
        tag "test"
        when {
            params {
                outdir = "$outputDir"
                only_peakcalling = true
                peakcaller = 'clippy'
            }
        }

        then {
            assert workflow.success

            // clippy
            assert file("$outputDir/05_peakcalling/clippy/PHO92.genome.peaks_rollmean10_minHeightAdjust1.0_minPromAdjust1.0_minGeneCount5_Peaks.bed").exists()
            assert file("$outputDir/05_peakcalling/clippy/PHO92.genome.peaks_rollmean10_minHeightAdjust1.0_minPromAdjust1.0_minGeneCount5_Summits.bed").exists()
            //assert file("$outputDir/05_peakcalling/clippy/PHO92.transcriptome.peaks_rollmean10_minHeightAdjust1.0_minPromAdjust1.0_minGeneCount5_Peaks.bed").exists()
            //assert file("$outputDir/05_peakcalling/clippy/PHO92.transcriptome.peaks_rollmean10_minHeightAdjust1.0_minPromAdjust1.0_minGeneCount5_Summits.bed").exists()
            // icount
            assert !(file("$outputDir/05_peakcalling/icountmini/PHO92.sigxls.bed").exists())
            assert !(file("$outputDir/05_peakcalling/icountmini/PHO92.peaks.bed").exists())
            // paraclu
            assert !(file("$outputDir/05_peakcalling/paraclu/PHO92.genome.peaks.clustered.simplified.bed").exists())
            //assert !(file("$outputDir/05_peakcalling/paraclu/PHO92.transcriptome.peaks.clustered.simplified.bed").exists())
            // pureclip
            assert !(file("$outputDir/05_peakcalling/pureclip/PHO92_pureclip_crosslinks.bed").exists())
            assert !(file("$outputDir/05_peakcalling/pureclip/PHO92_pureclip_peaks.bed").exists())
        }
    }

